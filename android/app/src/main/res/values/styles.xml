<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!--
        El tema de la ventana donde vive el WebView.

        **El gris de las franjas de arriba y de abajo era este tema.** Sin
        `windowBackground` propio, `Theme.AppCompat.DayNight` pinta su gris
        oscuro de fábrica (~#121212), y eso es lo que se veía detrás de la
        barra de estado y de la de navegación: la app negra en el medio y
        dos bandas grises en los bordes, como si fueran de otra aplicación.

        `statusBarColor` y `navigationBarColor` van igual aunque desde
        Android 15 el sistema las ignore (ahí las barras son transparentes y
        manda `windowBackground`): el APK corre desde Android 7, y en los
        anteriores son las que pintan.

        Los dos `enforce*Contrast` apagan el velo translúcido que Android
        pone detrás de la barra de gestos cuando cree que el contenido no se
        distingue. Sobre un fondo negro ese velo es justamente la banda más
        clara que se veía.
    -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/fondo</item>
        <item name="android:colorBackground">@color/fondo</item>
        <item name="android:statusBarColor">@color/fondo</item>
        <item name="android:navigationBarColor">@color/fondo</item>
        <!-- Fondo oscuro: los íconos del reloj y de la batería van claros. -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:navigationBarColor">@color/fondo</item>
        <item name="android:statusBarColor">@color/fondo</item>
    </style>
</resources>
