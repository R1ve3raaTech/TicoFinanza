# Copiar a .env.local y llenar con los valores del proyecto en https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo para procesos de servidor (eliminar cuenta). Nunca exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Client ID/Secret del OAuth Client de Google (Cloud Console > Credentials).
# La app pide unicamente los scopes basicos de perfil: openid, email, profile.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# API key de Resend, para el correo de bienvenida y el codigo de eliminacion
# de cuenta. Sin ella la app funciona igual, solo no manda esos correos.
RESEND_API_KEY=

# Claves VAPID de los recordatorios push de gastos fijos. Se generan una vez
# con `node scripts/generate-vapid-keys.mjs`. Sin ellas la app funciona
# igual, solo no manda recordatorios (el interruptor queda no disponible).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# Secreto del cron que manda los recordatorios (/api/reminders). Vercel lo
# manda como `Authorization: Bearer ...` en cada corrida programada; sin el,
# el endpoint responde 503 y no manda nada.
CRON_SECRET=
